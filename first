import PySimpleGUI as sg
import RPi.GPIO as GPIO
from time import sleep

layout = [[sg.Text('Press any hardware button', size=(None, None), key='-text-', auto_size_text=True, pad=((200,200),(300,300)), expand_x=True, expand_y=True, font=('Calibri', 48), justification='center')]]

window = sg.Window('RGB LED with Raspberry Pi', layout, size=(1280,800), finalize=True)

GPIO.setwarnings(False)
GPIO.setmode(GPIO.BOARD) #по простому номеру пина, от 1 до 40

GPIO.setup(35, GPIO.OUT, initial=GPIO.LOW) #red led
GPIO.setup(36, GPIO.OUT, initial=GPIO.LOW) #green led
GPIO.setup(37, GPIO.OUT, initial=GPIO.LOW) #blue led

GPIO.setup(7, GPIO.IN, pull_up_down=GPIO.PUD_DOWN)  #red button
GPIO.setup(11, GPIO.IN, pull_up_down=GPIO.PUD_DOWN) #green button
GPIO.setup(13, GPIO.IN, pull_up_down=GPIO.PUD_DOWN) #blue button


try:
    while True:
        # красная кнопка
        if GPIO.input(7) == GPIO.HIGH:
            GPIO.output(35, GPIO.HIGH)
            print('RED')
            window.Element('-text-').update('RED', text_color='red')
            window.refresh()
        else:
            GPIO.output(35, GPIO.LOW)

        # зелёная кнопка
        if GPIO.input(11) == GPIO.HIGH:
            GPIO.output(36, GPIO.HIGH)
            print('GREEN')
            window.Element('-text-').update('GREEN', text_color='green')
            window.refresh()
        else:
            GPIO.output(36, GPIO.LOW)

        # синяя кнопка
        if GPIO.input(13) == GPIO.HIGH:
            GPIO.output(37, GPIO.HIGH)
            print('BLUE')
            window.Element('-text-').update('BLUE', text_color='blue')
            window.refresh()
        else:
            GPIO.output(37, GPIO.LOW)

        sleep(0.1)

except KeyboardInterrupt: # если нажали Ctrl+C или крестик в окне
    window.close()
    GPIO.cleanup()

# закрываем окно и освобождаем используемые ресурсы
window.close()
GPIO.cleanup()
