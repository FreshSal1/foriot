import PySimpleGUI as sg
import RPi.GPIO as GPIO
from time import sleep

REDpressed = False

layout = [[sg.Text('Press any hardware button', size=(None, None), key='-text-', auto_size_text=True, pad=((200,200),(300,300)), expand_x=True, expand_y=True, font=('Calibri', 48), justification='center')]]

window = sg.Window('RGB LED with Raspberry Pi', layout, size=(1280,800), finalize=True)

GPIO.setwarnings(False)
GPIO.setmode(GPIO.BOARD) #по простому номеру пина, от 1 до 40
GPIO.setup(35, GPIO.OUT, initial=GPIO.LOW) #red led
GPIO.setup(7, GPIO.IN, pull_up_down=GPIO.PUD_DOWN) #red button

def REDcallback(channel):
    global REDpressed
    REDpressed = not REDpressed
    GPIO.output(35, REDpressed)
    print('RED')


GPIO.add_event_detect(7, GPIO.RISING, callback=REDcallback, bouncetime=300)

try:
    while True:
        if not REDpressed:
            window['-text-'].update('Press any hardware button', text_color='white')
            window.refresh()
        if REDpressed:
            window['-text-'].update('RED', text_color='red')
            window.refresh()

        sleep(0.1)

except KeyboardInterrupt:
    window.close()
    GPIO.cleanup()


# закрываем окно и освобождаем используемые ресурсы
window.close()
GPIO.cleanup()
